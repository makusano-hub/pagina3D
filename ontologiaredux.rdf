    <!-- http://www.Turismito3D.org/onto/turismo-Magallanes#TorresDelPaine -->

    <owl:NamedIndividual rdf:about="http://www.Turismito3D.org/onto/turismo-Magallanes#TorresDelPaine">
        <rdf:type rdf:resource="http://www.Turismito3D.org/onto/turismo-Magallanes#ParqueNacional"/>
        <PermiteActividadDe rdf:resource="http://www.Turismito3D.org/onto/turismo-Magallanes#TrekkingTorres"/>
        <UbicadoEnComuna rdf:resource="http://www.Turismito3D.org/onto/turismo-Magallanes#ComunaTorresDelPaine"/>
        <UbicadoEnProvincia rdf:resource="http://www.Turismito3D.org/onto/turismo-Magallanes#ProvinciaUltimaEsperanza"/>
        <AccesoTerrestre rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</AccesoTerrestre>
        <Calificacion rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">4.8</Calificacion>
        <Descripcion xml:lang="es-cl">El Parque Nacional Torres del Paine, en la región de la Patagonia de Chile, es conocido por sus altas montañas, los témpanos de azul brillante que se aferran a los glaciares y las pampas doradas (praderas) que albergan fauna poco común, como los guanacos. Algunos de los sitios más icónicos son las 3 torres de granito que le dan nombre al parque y las cimas con forma de cuernos llamadas Cuernos del Paine</Descripcion>
        <EsIconico rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</EsIconico>
        <EsPagado rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</EsPagado>
        <Nombre xml:lang="es-cl">Parque Nacional Torres del Paine</Nombre>
        <RequiereAvisoPrevioAutoridades rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</RequiereAvisoPrevioAutoridades>
    </owl:NamedIndividual>
    


