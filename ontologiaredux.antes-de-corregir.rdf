    <!-- http://www.Turismito3D.org/onto/turismo-Magallanes#TorresDelPaine -->

    <owl:NamedIndividual rdf:about="http://www.Turismito3D.org/onto/turismo-Magallanes#TorresDelPaine">
        <rdf:type rdf:resource="http://www.Turismito3D.org/onto/turismo-Magallanes#ParqueNacional"/>
        <turismo-Magallanes:PermiteActividadDe rdf:resource="http://www.Turismito3D.org/onto/turismo-Magallanes#trekkingTorres"/>
        <turismo-Magallanes:UbicadoEnComuna rdf:resource="http://www.Turismito3D.org/onto/turismo-Magallanes#ComunaTorresDelPaine"/>
        <turismo-Magallanes:UbicadoEnProvincia rdf:resource="http://www.Turismito3D.org/onto/turismo-Magallanes#ProvinciaUltimaEsperanza"/>
        <turismo-Magallanes:AccesoTerrestre rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</turismo-Magallanes:AccesoTerrestre>
        <turismo-Magallanes:Calificacion rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">4.8</turismo-Magallanes:Calificacion>
        <turismo-Magallanes:Descripcion>El Parque Nacional Torres del Paine, en la región de la Patagonia de Chile, es conocido por sus altas montañas, los témpanos de azul brillante que se aferran a los glaciares y las pampas doradas (praderas) que albergan fauna poco común, como los guanacos. Algunos de los sitios más icónicos son las 3 torres de granito que le dan nombre al parque y las cimas con forma de cuernos llamadas Cuernos del Paine</turismo-Magallanes:Descripcion>
        <turismo-Magallanes:EsIconico rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</turismo-Magallanes:EsIconico>
        <turismo-Magallanes:Nombre>Torres Del Paine</turismo-Magallanes:Nombre>
        <turismo-Magallanes:esPagado rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</turismo-Magallanes:esPagado>
        <turismo-Magallanes:requiereAvisoPrevioAutoridades rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</turismo-Magallanes:requiereAvisoPrevioAutoridades>
    </owl:NamedIndividual>
    


