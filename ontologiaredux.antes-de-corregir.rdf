    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.Turismito3D.org/onto/turismo-Magallanes#AdministradoPor -->

    <owl:ObjectProperty rdf:about="http://www.Turismito3D.org/onto/turismo-Magallanes#AdministradoPor"/>
    


    <!-- http://www.Turismito3D.org/onto/turismo-Magallanes#EsCapital -->

    <owl:ObjectProperty rdf:about="http://www.Turismito3D.org/onto/turismo-Magallanes#EsCapital">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
    </owl:ObjectProperty>
    


    <!-- http://www.Turismito3D.org/onto/turismo-Magallanes#PermiteActividadDe -->

    <owl:ObjectProperty rdf:about="http://www.Turismito3D.org/onto/turismo-Magallanes#PermiteActividadDe">
        <owl:inverseOf rdf:resource="http://www.Turismito3D.org/onto/turismo-Magallanes#seRealizaEn"/>
        <rdfs:domain rdf:resource="http://www.Turismito3D.org/onto/turismo-Magallanes#Lugar"/>
        <rdfs:range rdf:resource="http://www.Turismito3D.org/onto/turismo-Magallanes#Actividad"/>
    </owl:ObjectProperty>
    


    <!-- http://www.Turismito3D.org/onto/turismo-Magallanes#UbicadoEnCiudad -->

    <owl:ObjectProperty rdf:about="http://www.Turismito3D.org/onto/turismo-Magallanes#UbicadoEnCiudad">
        <rdfs:range rdf:resource="http://www.Turismito3D.org/onto/turismo-Magallanes#Ciudad"/>
    </owl:ObjectProperty>
    


    <!-- http://www.Turismito3D.org/onto/turismo-Magallanes#UbicadoEnComuna -->

    <owl:ObjectProperty rdf:about="http://www.Turismito3D.org/onto/turismo-Magallanes#UbicadoEnComuna">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.Turismito3D.org/onto/turismo-Magallanes#Ciudad"/>
                    <rdf:Description rdf:about="http://www.Turismito3D.org/onto/turismo-Magallanes#Lugar"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.Turismito3D.org/onto/turismo-Magallanes#Comuna"/>
    </owl:ObjectProperty>
    


    <!-- http://www.Turismito3D.org/onto/turismo-Magallanes#UbicadoEnProvincia -->

    <owl:ObjectProperty rdf:about="http://www.Turismito3D.org/onto/turismo-Magallanes#UbicadoEnProvincia">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.Turismito3D.org/onto/turismo-Magallanes#Comuna"/>
                    <rdf:Description rdf:about="http://www.Turismito3D.org/onto/turismo-Magallanes#Lugar"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.Turismito3D.org/onto/turismo-Magallanes#Provincia"/>
    </owl:ObjectProperty>
    


    <!-- http://www.Turismito3D.org/onto/turismo-Magallanes#seRealizaEn -->

    <owl:ObjectProperty rdf:about="http://www.Turismito3D.org/onto/turismo-Magallanes#seRealizaEn">
        <rdfs:domain rdf:resource="http://www.Turismito3D.org/onto/turismo-Magallanes#Actividad"/>
        <rdfs:range rdf:resource="http://www.Turismito3D.org/onto/turismo-Magallanes#Lugar"/>
    </owl:ObjectProperty>
    


